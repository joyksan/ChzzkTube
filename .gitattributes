# 자동으로 텍스트 파일을 감지하고 EOL을 LF로 정규화
* text=auto

# Python 파일은 명시적으로 LF 유지
*.py text eol=lf

# 마크다운 파일
*.md text eol=lf

# JSON 설정 파일
*.json text eol=lf

# YAML 파일
*.yml text eol=lf
*.yaml text eol=lf

# 배치 파일은 CRLF 유지 (Windows 호환성)
*.bat text eol=crlf
*.cmd text eol=crlf

# 바이너리 파일은 변환 없이 그대로
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.exe binary
*.dll binary
*.ttf binary
*.woff binary
*.woff2 binary
